{
  "name": "marvis-portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Portfolio of Muhammad Hamid — AI Automation Engineer. Next.js 16 static export, deployed to Firebase Hosting site 'marvis' at https://marvis.web.app.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:export": "NEXT_OUTPUT=export next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "og": "node scripts/generate-og.mjs",
    "sync": "node scripts/sync-data.mjs",
    "validate": "node scripts/validate.mjs",
    "ci": "bun run lint && bun run typecheck && bun run og && bun run build:export && bun run validate",
    "deploy": "bun run ci && firebase deploy --only hosting:marvis",
    "deploy:preview": "bun run ci && firebase hosting:channel:deploy preview --expires 7d --only hosting:marvis"
  },
  "keywords": [
    "portfolio",
    "ai-automation",
    "mcp",
    "nextjs",
    "firebase-hosting",
    "static-export"
  ],
  "author": "Muhammad Hamid",
  "license": "UNLICENSED",
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-select": "^2.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.2",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "sharp": "^0.34.3",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
